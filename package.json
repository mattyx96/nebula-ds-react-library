{
  "name": "nebula-ds-react-library",
  "private": false,
  "version": "0.0.41",
  "license": "MIT",
  "author": {
    "name": "mattyx96",
    "email": "matteoomicini.dev@gmail.com"
  },
  "description": "Nebula Design System React UI components",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json",
    "./style": "./dist/style.css"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "generate-themes": "node .scripts/generate-themes.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint src -c eslint.config.js --report-unused-disable-directives --max-warnings 0",
    "lint-fix": "eslint src -c eslint.config.js --fix",
    "test": "vitest",
    "storybook": "pnpm run build && storybook dev -p 6006",
    "build-storybook": "pnpm run build && storybook build",
    "release": "sh ./.scripts/release.sh"
  },
  "dependencies": {
    "nebula-ds-tokens": "0.2.0"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
