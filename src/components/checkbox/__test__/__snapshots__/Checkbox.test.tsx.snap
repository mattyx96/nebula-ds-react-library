exports[`Checkbox > renders a label and an unchecked checkbox 1`] = `
<label
  class="nb-checkbox__root"
  data-part="root"
  data-scope="checkbox"
  data-state="unchecked"
  for="checkbox:_r_0_:input"
  id="checkbox:_r_0_"
>
  <span
    aria-hidden="true"
